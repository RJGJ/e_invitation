// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid()) @postgresql.Uuid
  name         String    @default("")
  email        String    @unique @default("")
  password     String
  posts        Post[]    @relation("Post_author")
  media        Media[]   @relation("Media_uploadedBy")
  createdAt    DateTime? @default(now())
  isAdmin      Boolean   @default(false)
  refreshToken String?
}

model Post {
  id       String  @id @default(uuid()) @postgresql.Uuid
  title    String  @default("")
  content  Json    @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  author   User?   @relation("Post_author", fields: [authorId], references: [id])
  authorId String? @map("author") @postgresql.Uuid
  tags     Tag[]   @relation("Post_tags")

  @@index([authorId])
}

model Tag {
  id    String @id @default(uuid()) @postgresql.Uuid
  name  String @default("")
  posts Post[] @relation("Post_tags")
}

model Media {
  id           String    @id @default(uuid()) @postgresql.Uuid
  filename     String    @default("")
  mimeType     String    @default("")
  size         Int
  driver       String
  storageKey   String    @default("")
  url          String    @default("")
  width        Int?
  height       Int?
  uploadedBy   User?     @relation("Media_uploadedBy", fields: [uploadedById], references: [id])
  uploadedById String?   @map("uploadedBy") @postgresql.Uuid
  createdAt    DateTime? @default(now())
  deletedAt    DateTime?

  @@index([uploadedById])
}
