// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid()) @postgresql.Uuid
  name         String    @default("")
  email        String    @unique @default("")
  password     String
  posts        Post[]    @relation("Post_author")
  media        Media[]   @relation("Media_uploadedBy")
  events       Event[]   @relation("Event_author")
  createdAt    DateTime? @default(now())
  isAdmin      Boolean   @default(false)
  refreshToken String?
}

model Post {
  id       String  @id @default(uuid()) @postgresql.Uuid
  title    String  @default("")
  content  Json    @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  author   User?   @relation("Post_author", fields: [authorId], references: [id])
  authorId String? @map("author") @postgresql.Uuid
  tags     Tag[]   @relation("Post_tags")

  @@index([authorId])
}

model Tag {
  id    String @id @default(uuid()) @postgresql.Uuid
  name  String @default("")
  posts Post[] @relation("Post_tags")
}

model Media {
  id              String    @id @default(uuid()) @postgresql.Uuid
  image_id        String?
  image_filesize  Int?
  image_width     Int?
  image_height    Int?
  image_extension String?
  uploadedBy      User?     @relation("Media_uploadedBy", fields: [uploadedById], references: [id])
  uploadedById    String?   @map("uploadedBy") @postgresql.Uuid
  coverOfEvent    Event?    @relation("Event_coverImage")
  galleryOfEvents Event[]   @relation("Event_gallery")
  createdAt       DateTime? @default(now())
  deletedAt       DateTime?

  @@index([uploadedById])
}

model Event {
  id              String    @id @default(uuid()) @postgresql.Uuid
  author          User?     @relation("Event_author", fields: [authorId], references: [id])
  authorId        String?   @map("author") @postgresql.Uuid
  title           String    @default("")
  description     String    @default("")
  type            String
  startDate       DateTime
  endDate         DateTime?
  timezone        String    @default("")
  venueName       String    @default("")
  address         String    @default("")
  latitude        Float?
  longitude       Float?
  coverImage      Media?    @relation("Event_coverImage", fields: [coverImageId], references: [id])
  coverImageId    String?   @unique @map("coverImage") @postgresql.Uuid
  gallery         Media[]   @relation("Event_gallery")
  template        Template? @relation("Event_template", fields: [templateId], references: [id])
  templateId      String?   @map("template") @postgresql.Uuid
  allowPlusOne    Boolean   @default(false)
  rsvpDeadline    DateTime?
  requireApproval Boolean   @default(false)
  primaryColor    String    @default("")
  secondaryColor  String    @default("")
  fontFamily      String    @default("")
  createdAt       DateTime? @default(now())
  updatedAt       DateTime?
  deletedAt       DateTime?

  @@index([authorId])
  @@index([templateId])
}

model Template {
  id               String    @id @default(uuid()) @postgresql.Uuid
  name             String    @default("")
  type             String
  motif            String    @default("")
  accentHex        String    @default("")
  isActive         Boolean   @default(true)
  templateOfEvents Event[]   @relation("Event_template")
  createdAt        DateTime? @default(now())
}
